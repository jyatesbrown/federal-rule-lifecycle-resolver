                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "default": null
                        },
                        "effectiveOn": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "default": null
                        },
                        "rins": {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "docketIds": {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "sourceUrl": {
                            "anyOf": [
                                {
                                    "type": "string"
