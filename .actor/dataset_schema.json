                                "type": "null"
                            }
                        ],
                        "default": null
                    }
                },
                "required": [
                    "inputType",
                    "input"
                ],
                "type": "object"
            },
            "checkedAt": {
                "type": "string"
            },
            "scopeNote": {
                "default": "Administrative rulemaking record only (Federal Register and Regulations.gov). Does not reflect court decisions, injunctions, stays, appropriations riders, enforcement policy or state law unless a Federal Register document itself announces the change. Not legal advice.",
