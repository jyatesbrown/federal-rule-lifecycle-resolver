{
    "actorSpecification": 1,
    "fields": {
        "properties": {
            "schemaVersion": {
                "default": "1.0",
                "type": "string"
            },
            "status": {
                "enum": [
                    "resolved",
                    "partial",
                    "ambiguous",
                    "not_found",
                    "conflicting_identifiers",
                    "insufficient_data"
                ],
                "type": "string"
            },
            "query": {
                "properties": {
                    "inputType": {
                        "enum": [
                            "federal_register_document_number",
                            "federal_register_url",
                            "rin",
                            "docket_id",
                            "query"
                        ],
                        "type": "string"
                    },
                    "input": {
                        "type": "string"
                    },
                    "agency": {
                        "anyOf": [
                            {
                                "type": "string"
