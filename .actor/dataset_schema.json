                                    "type": "string"
                                },
                                "type": "array"
                            }
                        },
                        "required": [
                            "canonicalTitle",
                            "agencies",
                            "rins",
                            "docketIds",
                            "cfrParts"
                        ],
                        "type": "object"
                    },
                    {
                        "type": "null"
                    }
                ],
                "default": null
            },
            "lifecycle": {
                "anyOf": [
                    {
                        "properties": {
                            "currentStage": {
                                "description": "pre_rule: only an advance notice exists. proposed_comment_open/closed: a proposal exists, no final rule, latest comment deadline in the future/past. final_rule_not_yet_effective / effective: a final rule exists and its current effective date is in the future/has passed. withdrawn: an official document withdraws the action. unknown: official data is insufficient. Extensions, corrections and delays adjust dates; they are never a stage themselves.",
                                "enum": [
                                    "pre_rule",
                                    "proposed_comment_open",
                                    "proposed_comment_closed",
                                    "final_rule_not_yet_effective",
                                    "effective",
                                    "withdrawn",
                                    "unknown"
                                ],
                                "type": "string"
                            },
                            "stageBasis": {
                                "description": "Deterministic reasons for currentStage, citing document numbers.",
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            "proposedRulePublished": {
                                "anyOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "commentPeriod": {
                                "properties": {
                                    "originalDeadline": {
                                        "anyOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ],
                                        "description": "Comment deadline of the first proposal (YYYY-MM-DD)."
                                    },
                                    "currentDeadline": {
                                        "anyOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ],
                                        "description": "Latest comment deadline after extensions/reopenings/supplements."
                                    },
                                    "extended": {
                                        "anyOf": [
                                            {
                                                "type": "boolean"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ],
                                        "description": "True when an extension, reopening or supplemental proposal moved it."
                                    },
                                    "open": {
                                        "anyOf": [
                                            {
                                                "type": "boolean"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ],
                                        "description": "currentDeadline is today or later (as of checkedAt, US Eastern)."
                                    }
                                },
                                "required": [
                                    "originalDeadline",
                                    "currentDeadline",
                                    "extended",
                                    "open"
                                ],
                                "type": "object"
                            },
                            "finalRulePublished": {
                                "anyOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "effectiveDate": {
                                "properties": {
                                    "original": {
                                        "anyOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ],
                                        "description": "Effective date stated by the final rule when published."
                                    },
                                    "current": {
                                        "anyOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ],
                                        "description": "Effective date after any delay documents."
                                    },
                                    "delayed": {
                                        "anyOf": [
                                            {
                                                "type": "boolean"
                                            },
                                            {
                                                "type": "null"
                                            }
                                        ]
                                    }
                                },
                                "required": [
                                    "original",
                                    "current",
                                    "delayed"
                                ],
                                "type": "object"
                            },
                            "withdrawnOn": {
                                "anyOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "default": null
                            },
                            "latestOfficialActionDate": {
                                "anyOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            },
                            "latestOfficialAction": {
                                "anyOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "default": null,
                                "description": "Document number of the latest action."
                            }
                        },
                        "required": [
                            "currentStage",
                            "stageBasis",
                            "proposedRulePublished",
                            "commentPeriod",
                            "finalRulePublished",
                            "effectiveDate",
                            "latestOfficialActionDate"
                        ],
                        "type": "object"
                    },
                    {
                        "type": "null"
                    }
                ],
                "default": null
