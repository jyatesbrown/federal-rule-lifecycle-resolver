            },
            "action": {
                "anyOf": [
                    {
                        "properties": {
                            "canonicalTitle": {
                                "description": "Title of the anchor document (latest final rule, else latest proposal).",
                                "type": "string"
                            },
                            "agencies": {
                                "items": {
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        },
                                        "slug": {
                                            "anyOf": [
                                                {
                                                    "type": "string"
                                                },
                                                {
                                                    "type": "null"
                                                }
                                            ],
                                            "default": null
                                        }
                                    },
                                    "required": [
                                        "name"
                                    ],
                                    "type": "object"
                                },
                                "type": "array"
                            },
                            "rins": {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            "docketIds": {
                                "description": "Regulations.gov-style docket IDs from the official records.",
