                    "action",
                    "lifecycle",
                    "resolution",
                    "billing"
                ],
                "fields": [
                    "status",
                    "action.canonicalTitle",
                    "action.rins",
                    "action.docketIds",
                    "lifecycle.currentStage",
                    "lifecycle.commentPeriod.currentDeadline",
                    "lifecycle.effectiveDate.current",
                    "lifecycle.latestOfficialActionDate",
                    "resolution.confidence",
                    "billing.billable",
                    "checkedAt"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "status": {
                        "label": "Status",
                        "format": "text"
                    },
                    "action.canonicalTitle": {
                        "label": "Rulemaking",
                        "format": "text"
                    },
                    "action.rins": {
                        "label": "RINs",
                        "format": "array"
                    },
                    "action.docketIds": {
                        "label": "Dockets",
                        "format": "array"
                    },
                    "lifecycle.currentStage": {
                        "label": "Stage",
                        "format": "text"
                    },
                    "lifecycle.commentPeriod.currentDeadline": {
                        "label": "Comment deadline",
                        "format": "text"
                    },
                    "lifecycle.effectiveDate.current": {
                        "label": "Effective date",
                        "format": "text"
                    },
                    "lifecycle.latestOfficialActionDate": {
                        "label": "Latest action",
                        "format": "text"
                    },
                    "resolution.confidence": {
                        "label": "Confidence",
                        "format": "text"
                    },
                    "billing.billable": {
                        "label": "Billable",
                        "format": "boolean"
                    },
                    "checkedAt": {
                        "label": "Checked at",
                        "format": "date"
                    }
                }
            }
        },
        "documents": {
            "title": "Related documents",
            "description": "One row per official Federal Register document in the lifecycle.",
            "transformation": {
                "unwind": [
                    "relatedDocuments"
                ],
                "fields": [
                    "documentNumber",
                    "normalizedType",
                    "nativeAction",
                    "publicationDate",
                    "relationBasis",
                    "sourceUrl"
